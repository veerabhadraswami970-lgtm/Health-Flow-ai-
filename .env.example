# HealthFlow AI - Environment Configuration Example

# Core Server Settings
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=healthflow-ai-super-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
QR_TOKEN_EXPIRE_MINUTES=30

# Persistence: 'local' (zero-dependency JSON store) or 'firestore' (live Google Cloud)
PERSISTENCE_MODE=local
LOCAL_STORAGE_DIR=backend/data_store
FIREBASE_CREDENTIALS_PATH=
FIREBASE_STORAGE_BUCKET=

# ABDM & Integration Sandboxes (Set to True for local zero-dependency operation)
USE_MOCK_INTEGRATIONS=True
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_SANDBOX_BASE_URL=https://dev.abdm.gov.in/gateway/v0.5

# Telephony Provider: 'mock', 'twilio', or 'exotel'
TELEPHONY_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=

# National Emergency Numbers (India)
EMERGENCY_AMBULANCE_NUMBER=108
EMERGENCY_NATIONAL_NUMBER=112
EMERGENCY_MATERNAL_NUMBER=102
